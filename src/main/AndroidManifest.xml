<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <application android:label="Calendrier" android:icon="@drawable/ic_launcher" android:allowBackup="true">
        <activity android:name=".MainActivity" android:exported="true" android:label="Nouvelle tâche"
            android:theme="@android:style/Theme.DeviceDefault.Dialog.MinWidth"
            android:excludeFromRecents="true" android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver android:name=".CalWidget" android:exported="false" android:label="Mois + to-do">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_info" />
        </receiver>
        <receiver android:name=".WeekWidget" android:exported="false" android:label="Aujourd'hui">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_week_info" />
        </receiver>
    </application>
</manifest>
