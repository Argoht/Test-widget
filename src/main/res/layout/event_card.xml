<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/card" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="@drawable/bg_card" android:layout_marginBottom="6dp"
    android:paddingHorizontal="14dp" android:paddingVertical="10dp">
    <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="15sp" android:textColor="@color/fg" android:singleLine="true" android:ellipsize="end"/>
    <TextView android:id="@+id/time" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp"
        android:textSize="13sp" android:textColor="@color/fg2" android:singleLine="true"/>
</LinearLayout>
