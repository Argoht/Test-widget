<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/item" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="6dp">
    <ImageView android:id="@+id/check" android:layout_width="14dp" android:layout_height="14dp"
        android:layout_marginTop="1dp" android:layout_marginEnd="8dp" android:src="@drawable/ring"/>
    <TextView android:id="@+id/text" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
        android:textSize="12sp" android:textColor="#FFFFFF" android:maxLines="2" android:ellipsize="end"/>
</LinearLayout>
